# ── SERVER ENVIRONMENT VARIABLES ─────────────────────────────────────────────
# Copy this file to server/.env and fill in the values
# NEVER commit server/.env to git

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/turnup?retryWrites=true&w=majority

# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

PORT=5000

# Client URL (for CORS) — use localhost for dev, Vercel URL for production
CLIENT_URL=http://localhost:5173

# Admin Account (seeded automatically on first server startup)
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=your-secure-password-min-6-chars
ADMIN_NAME=Sports Head

# Email — Brevo (HTTP-based, works on Railway where SMTP is often firewalled)
# 1. Create a free account at https://brevo.com
# 2. Get your API key at: https://app.brevo.com/settings/keys/api
# 3. Verify your sender email at: https://app.brevo.com/senders
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=your-verified-sender@yourdomain.com

# ── PRODUCTION PLATFORM ENV VARS (set on Railway dashboard, NOT here) ────────
# TZ=Asia/Karachi          ← Critical: prevents 5-hour timezone offset on UTC servers
# NODE_ENV=production
# CLIENT_URL=https://turnup-pi.vercel.app   ← update to your Vercel URL
# NIXPACKS_NODE_VERSION=18                  ← ensures Railway uses Node 18

# ── CLIENT ENVIRONMENT VARIABLES ─────────────────────────────────────────────
# For local dev: leave blank — Vite proxy handles /api → localhost:5000
# For production: set on Vercel dashboard (Project → Settings → Environment Variables)
#
# VITE_API_URL=https://your-railway-app.up.railway.app/api
