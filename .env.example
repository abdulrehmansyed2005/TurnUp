# Server Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/turnup?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-this
PORT=5000

# IMPORTANT: Set this on your hosting platform (Render/Railway) so date/time logic works correctly
# Without this, a UTC server will be 5 hours behind Lahore time, breaking slot availability
TZ=Asia/Karachi

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Account (seeded on first startup)
ADMIN_EMAIL=your-email@lhr.nu.edu.pk
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Sports Head

# Email — Gmail SMTP (requires 2-Step Verification + App Password)
# Generate App Password at: myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
