# Server Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/turnup?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-this
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Account (seeded on first startup)
ADMIN_EMAIL=your-email@lhr.nu.edu.pk
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Sports Head

# Email (for OTP — use Gmail App Password)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
